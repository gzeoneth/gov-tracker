{
  "name": "@gzeoneth/gov-tracker",
  "version": "0.1.2",
  "description": "Lightweight, high-performance library for tracking Arbitrum DAO governance proposal lifecycle stages",
  "license": "Apache-2.0",
  "author": "gzeoneth",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gzeoneth/gov-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/gzeoneth/gov-tracker/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "gov-tracker": "dist/cli/monitor.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "NO_RPC=1 vitest run",
    "test:integration": "vitest run test/integration.test.ts test/tracker.test.ts test/retryables.test.ts",
    "test:fork": "vitest run --config vitest.config.fork.mts",
    "test:all": "vitest run",
    "test:coverage": "NO_RPC=1 vitest run --coverage",
    "test:coverage:all": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint --quiet",
    "lint:fix": "eslint --fix",
    "check:unused": "knip",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepublishOnly": "yarn lint && yarn format:check && yarn build",
    "prepare": "husky",
    "monitor": "ts-node src/cli/monitor.ts",
    "monitor:run": "ts-node src/cli/monitor.ts run",
    "monitor:status": "ts-node src/cli/monitor.ts status",
    "monitor:track": "ts-node src/cli/monitor.ts track",
    "monitor:inspect": "ts-node src/cli/monitor.ts inspect"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@arbitrum/sdk": "^4.0.0",
    "commander": "^14.0.2",
    "debug": "^4.3.4",
    "dotenv": "^17.2.3",
    "ethers": "^5.7.2",
    "p-limit": "3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/debug": "^4.1.12",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "knip": "^5.80.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
