{
  "name": "@gzeoneth/gov-tracker",
  "version": "0.3.0",
  "description": "Lightweight, high-performance library for tracking Arbitrum DAO governance proposal lifecycle stages",
  "license": "Apache-2.0",
  "author": "gzeoneth",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gzeoneth/gov-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/gzeoneth/gov-tracker/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bundled-cache.json": "./dist/data/bundled-cache.json"
  },
  "bin": {
    "gov-tracker": "dist/cli/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && cp -r data dist/",
    "test": "NO_RPC=1 vitest run",
    "test:rpc": "vitest run",
    "test:fork": "vitest run --config vitest.config.fork.mts",
    "test:cov": "vitest run --coverage",
    "test:cov:fork": "vitest run --config vitest.config.fork.mts --coverage",
    "test:cov:merge": "./scripts/merge-coverage.sh",
    "test:cov:all": "yarn test:cov && yarn test:cov:fork && yarn test:cov:merge",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint --quiet",
    "lint:fix": "eslint --fix",
    "check:unused": "knip",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepublishOnly": "yarn lint && yarn format:check && yarn build",
    "prepare": "husky",
    "cli": "ts-node src/cli/cli.ts",
    "cli:run": "ts-node src/cli/cli.ts run",
    "cli:status": "ts-node src/cli/cli.ts status",
    "cli:track": "ts-node src/cli/cli.ts track",
    "cli:election": "ts-node src/cli/cli.ts election",
    "cache:generate": "ts-node src/cli/cli.ts --cache ./data/bundled-cache.json --concurrency 3 --force"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@arbitrum/sdk": "^4.0.0",
    "debug": "^4.4.0",
    "ethers": "^5.8.0"
  },
  "optionalDependencies": {
    "commander": "^14.0.0",
    "ink": "^3.2.0",
    "react": "^17.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/debug": "^4.1.12",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitest/coverage-v8": "^4.0.0",
    "dotenv": "^17.0.0",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "knip": "^5.80.0",
    "lint-staged": "^16.2.7",
    "node-pty": "^1.1.0",
    "nyc": "^17.1.0",
    "prettier": "^3.7.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.0",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
